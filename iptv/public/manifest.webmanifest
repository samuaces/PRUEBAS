{
  "name": "Mi IPTV",
  "short_name": "Mi IPTV",
  "description": "Tus listas IPTV ordenadas en peliculas, series y canales, con favoritos y recomendaciones.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "/#/home",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#000000",
  "categories": ["entertainment", "video"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Buscar", "url": "/#/buscar", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "TV en directo", "url": "/#/tv", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Favoritos", "url": "/#/favoritos", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
