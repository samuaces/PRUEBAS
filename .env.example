# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # server only — never expose to the browser

# Visit counting (lib/visitor.ts)
VISITOR_SALT=                       # openssl rand -hex 32

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Admin
ADMIN_PASSWORD=

# Automatic link filter
SAFE_BROWSING_API_KEY=
OPENAI_API_KEY=                     # optional — content moderation check; skipped (fail-open) if unset

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=klym <info@cuantomedeben.es>

# Added beyond the base brief — required for the owner-link tokens and the cron endpoint
ENTRY_TOKEN_SECRET=                 # openssl rand -hex 32 — signs klym.xyz/e/<token> owner links
CRON_SECRET=                        # openssl rand -hex 32 — Vercel sends this as a Bearer token to /api/cron/tick

NEXT_PUBLIC_SITE_URL=https://klym.xyz
