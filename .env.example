# EmailPilot environment variables
# Copy to .env.local and fill in real values to exit simulation mode

# Anthropic API (for real AI icebreaker generation)
ANTHROPIC_API_KEY=sk-ant-...

# Stripe (for real payments - required to exit simulation mode)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# App config
DB_PATH=./emailpilot.db
PORT=8000
